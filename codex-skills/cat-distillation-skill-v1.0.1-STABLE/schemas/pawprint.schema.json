{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pawprint Atom",
  "type": "object",
  "required": [
    "id",
    "jar",
    "trigger",
    "attention",
    "preference",
    "move",
    "visible_effect",
    "boundaries",
    "evidence_refs",
    "support_level",
    "task_tags",
    "source_tags",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "jar": {
      "enum": [
        "SENSE_JAR",
        "TASTE_JAR",
        "CRAFT_JAR",
        "VOICE_JAR",
        "RELATION_JAR"
      ]
    },
    "trigger": {
      "type": "string",
      "minLength": 5
    },
    "attention": {
      "type": "string",
      "minLength": 3
    },
    "preference": {
      "type": "string",
      "minLength": 3
    },
    "move": {
      "type": "string",
      "minLength": 5
    },
    "visible_effect": {
      "type": "string",
      "minLength": 3
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "support_level": {
      "enum": [
        "strong",
        "medium",
        "weak",
        "hypothesis"
      ]
    },
    "counterexamples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "task_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "candidate",
        "tested",
        "active",
        "retired"
      ]
    },
    "replaces": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    },
    "trial_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contrast_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_uses_per_output": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "minimum_gap_paragraphs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "fallback_move": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
